  <widget class="QWidget" name="centralwidget">
   <property name="styleSheet">
    <string notr="true">*{
	border: none;
	color: #060606;
}

QToolTip{
background-color: #d9d1d5;
color: #413abc;
font: bold 12px 'Helvetica';
padding: 4px;
}

#centralwidget{
	background-color: #eaeaea;
}

#stackedWidget{
	background-color: #D4EEFB;
}

#Header_widget{
    background-color: #9BC9FF;
}

#LeftSideMenuwidget{
	background-color: qlineargradient(spread:pad, x1:0.459, y1:1, x2:0.525453, y2:0.091, stop:0 rgba(70, 63, 204, 255), stop:0.793296 rgba(32, 28, 87, 255));
}


#Dashboard_pushButton, #Expenses_pushButton, #Purchases_pushButton, #Reports_pushButton, #Sales_pushButton, #Stock_pushButton, #Suppliers_pushButton, #About_pushButton, #LogOut_pushButton,#Settings_pushButton{
padding: 5px;
text-align: left;
}

#Searching_frame{
border: 2px solid #413abc;
border-radius: 5px;

}

#Searching_lineEdit{
background: transparent;
}

#Profile_label{
border: 3px solid #413abc;
border-radius: 8px;
}

#Dashboard_pushButton:hover, #Expenses_pushButton:hover, #Purchases_pushButton:hover, #Reports_pushButton:hover, #Sales_pushButton:hover, #Stock_pushButton:hover, #Suppliers_pushButton:hover{
	background-color: #413abc;
	border-radius: 7px;
	padding-left: 3px;
}

#About_pushButton:hover, #LogOut_pushButton:hover, #Settings_pushButton:hover{
	background-color: #2a2575;
	border-radius: 7px;
	padding-left: 3px;
}

#Notification_pushButton:hover, #Theme_pushButton:hover, #Edit_Product_pushButton:hover, #New_Product_pushButton:hover, #Remove_Product_pushButton:hover{
	padding-top: 3px;
	background-color: #BEC6ED;
	border: 1px solid #828eff;
	border-radius: 6px;

}

#Notification_pushButton:checked, #Theme_pushButton:checked, #Edit_Product_pushButton:checked, #New_Product_pushButton:checked, #Remove_Product_pushButton:checked{
	background-color: #D5DAF3;
	border-top: 2px solid #603090;
	border-top-left-radius: 7px;
	border-top-right-radius: 7px;
	font-weight: bold;

}


#Dashboard_pushButton:checked, #Expenses_pushButton:checked, #Purchases_pushButton:checked, #Reports_pushButton:checked, #Sales_pushButton:checked, #Stock_pushButton:checked, #Suppliers_pushButton:checked, #About_pushButton:checked, #LogOut_pushButton:checked,#Settings_pushButton:checked{
	
	background-color: #D4EEFB;
	border-left: 4px solid #603090;
	border-top-left-radius: 7px;
	border-bottom-left-radius: 7px;
}



#DashBoardLogoframe, #Revenue_Card_frame, #Expenses_Card_frame, #Profit_Card_frame, #StockIN_Card_frame, #StockOUT_frame, #StockRemain_frame{

	border: 4px solid #603090;
	border-radius: 20px;
}

#Duration_comboBox, #Products_comboBox, #Select_Category_comboBox, #Select_Date_comboBox{
background-color: #D4EEFB;
	border: 1px solid #603090;
	border-radius: 6px;
	padding: 4px 10px;
	min-width: 50px;
}


#Duration_comboBox:hover, #Products_comboBox:hover, #Select_Category_comboBox:hover, #Select_Date_comboBox:hover{

	border: 1px solid #828eff;
}

#Duration_comboBox::down-arrow, #Products_comboBox::down-arrow, #Select_Category_comboBox::down-arrow, #Select_Date_comboBox::down-arrow{
	image: url(:/Blue/Icons/BlueIcons/chevron-down.svg);
	width: 20px;
	height: 12px;
}


#Duration_comboBox QAbstractItemView, #Products_comboBox QAbstractItemView, #Select_Category_comboBox QAbstractItemView, #Select_Date_comboBox QAbstractItemView{
background-color: #D4EEFB;
border: 1px solid #acffc8;
selection-background-color: #423AC1;
selection-color: #0F2771;
foint-size: 13px;
padding: 4px;
}


#Top_10_Product_tableWidget{
	background-color: #D4EEFB;
    border: 1px solid #6C7FD8;
    border-radius: 6px;
    font-size: 14px;
    selection-background-color: #0078d7;
    selection-color: #ffffff; 
    alternate-background-color: #6C7FD8;  
}


#Top_10_Product_tableWidget QHeaderView::section {
    background-color: #9BC9FF;
    color: white;
    padding: 4px;
    font-weight: bold;
    border: 1px solid #cccccc;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}






